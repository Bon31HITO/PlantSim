<Window x:Class="PlantSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PlantSim"
        Title="The Algorithmic Beauty of Plants - Simulator"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- Light Theme Palette -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#0369A1"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ViewportBackgroundBrush" Color="#E2E8F0"/>

        <!-- Common Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Outline Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Top Level TabItem Style -->
        <Style x:Key="TopLevelTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Application Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area with Chapters Tabs -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="The Algorithmic Beauty of Plants" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="5,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Simulator" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="P. Prusinkiewicz &amp; A. Lindenmayer" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Top-Level Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,6,10,10">

            <!-- ========================================== -->
            <!-- CHAPTER 1 TAB                              -->
            <!-- ========================================== -->
            <TabItem Header="🌱 第1章：L-System 植物形態形成" Style="{StaticResource TopLevelTabItemStyle}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chapter 1 Sidebar -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Preset Selection" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ChapterOnePresets}"
                                          SelectedItem="{Binding SelectedChapterOnePreset}"
                                          DisplayMemberPath="Title"
                                          Background="#FFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                                          BorderBrush="{StaticResource InputBorderBrush}"
                                          Padding="5" Margin="0,0,0,6"/>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedChapterOnePreset.SectionReference}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedChapterOnePreset.Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" FontSize="10"/>
                                    </StackPanel>
                                </Border>

                                <!-- Grammar Editor -->
                                <TextBlock Text="Axiom (ω):" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding AxiomText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource InputBorderBrush}" FontFamily="Consolas" FontSize="11" Padding="3" Margin="0,2,0,6"/>

                                <TextBlock Text="Production Rules (P):" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding RulesText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource InputBorderBrush}" FontFamily="Consolas" FontSize="11"
                                         AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" Padding="3" Margin="0,2,0,6"/>

                                <TextBlock Text="Interpretation Rules (h):" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding InterpretationRulesText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource InputBorderBrush}" FontFamily="Consolas" FontSize="11"
                                         AcceptsReturn="True" Height="55" VerticalScrollBarVisibility="Auto" Padding="3" Margin="0,2,0,6"/>

                                <TextBlock Text="Ignored Symbols:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding IgnoredSymbolsText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource InputBorderBrush}" FontFamily="Consolas" FontSize="11" Padding="3" Margin="0,2,0,8"/>

                                <!-- Derivation Sliders -->
                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Derivation Steps (n)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DerivationStepCount}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="14" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True"
                                        TickFrequency="1" Value="{Binding DerivationStepCount}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Angle (δ)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding AngleInDegrees, StringFormat='{}{0:F1}°'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="180" SmallChange="0.5" Value="{Binding AngleInDegrees}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Step Length (d)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding StepLength, StringFormat='{}{0:F1}'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0.5" Maximum="30" SmallChange="0.5" Value="{Binding StepLength}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Tropism Susceptibility (e)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TropismSusceptibility, StringFormat='{}{0:F3}'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0.0" Maximum="0.15" SmallChange="0.005" Value="{Binding TropismSusceptibility}" Margin="0,0,0,8"/>

                                <!-- Action Buttons -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Generate" Height="32" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GenerateCommand}"/>
                                    <Button Grid.Column="2" Content="Cancel" Height="32" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Reset Camera" Height="26" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Command="{Binding ResetCameraCommand}"/>
                                    <Button Grid.Column="2" Content="Load Patch" Height="26" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Command="{Binding LoadSurfacePatchCommand}"/>
                                </Grid>

                                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding ProgressRatio, Mode=OneWay}"
                                             Foreground="{StaticResource PrimaryAccentBrush}" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,8"/>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Status" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryAccentBrush}" TextWrapping="Wrap" Margin="0,1,0,3" FontSize="10"/>
                                        <TextBlock Text="{Binding GeneratedSymbolCount, StringFormat='Word Length: {0:N0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding GeneratedSegmentCount, StringFormat='Branches: {0:N0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Chapter 1 Main Views (3D & Growth Curve) -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="6">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <!-- Sub Tab 1: 3D Plant Model -->
                            <TabItem Header="3D モデル描画" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                <Border Background="{StaticResource ViewportBackgroundBrush}" CornerRadius="5" ClipToBounds="True"
                                        local:OrbitCameraController.IsEnabled="True"
                                        local:OrbitCameraController.ResetTrigger="{Binding CameraResetTrigger}">
                                    <Viewport3D Focusable="True" RenderOptions.EdgeMode="Aliased">
                                        <Viewport3D.Camera>
                                            <PerspectiveCamera Position="90,40,90" LookDirection="-90,-10,-90" UpDirection="0,1,0" FieldOfView="45"/>
                                        </Viewport3D.Camera>
                                        <ModelVisual3D>
                                            <ModelVisual3D.Content>
                                                <Model3DGroup>
                                                    <AmbientLight Color="#707070"/>
                                                    <DirectionalLight Color="#FFFFFF" Direction="-1,-2,-1"/>
                                                    <DirectionalLight Color="#506070" Direction="1,1,1"/>
                                                </Model3DGroup>
                                            </ModelVisual3D.Content>
                                        </ModelVisual3D>
                                        <ModelVisual3D Content="{Binding RenderedThreeDimensionalModel}"/>
                                    </Viewport3D>
                                </Border>
                            </TabItem>

                            <!-- Sub Tab 2: Growth Kinetics Plot (Responsive with Viewbox) -->
                            <TabItem Header="成長解析 (Sec 1.9)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                <Border Background="#FFFFFF" CornerRadius="5" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="L-System Growth Kinetics Analysis" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding GrowthAnalysisSummary}" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="5">
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8">
                                                <Canvas Width="600" Height="300">
                                                    <Line X1="30" Y1="270" X2="570" Y2="270" Stroke="#94A3B8" StrokeThickness="1"/>
                                                    <Line X1="30" Y1="30" X2="30" Y2="270" Stroke="#94A3B8" StrokeThickness="1"/>
                                                    <TextBlock Text="Step (n)" Canvas.Left="530" Canvas.Top="275" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                    <TextBlock Text="Total Symbols" Canvas.Left="10" Canvas.Top="15" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                    <Polyline Points="{Binding GrowthCurvePoints}" Stroke="{StaticResource PrimaryAccentBrush}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- CHAPTER 2 TAB                              -->
            <!-- ========================================== -->
            <TabItem Header="🌳 第2章：樹木生理・構造シミュレータ" Style="{StaticResource TopLevelTabItemStyle}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chapter 2 Parameters & Controls -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Tree Preset" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ChapterTwoSimulationPresets}"
                                          SelectedItem="{Binding SelectedChapterTwoSimulationPreset}"
                                          DisplayMemberPath="Title"
                                          Background="#FFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                                          BorderBrush="{StaticResource InputBorderBrush}"
                                          Padding="5" Margin="0,0,0,6"/>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding SelectedChapterTwoSimulationPreset.Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                </Border>

                                <!-- Branching Geometry -->
                                <TextBlock Text="Branching Geometry (Sec 2.2)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,4"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Main Angle (α1)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding InteractiveMainAngle, StringFormat='{}{0:F1}°'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="90" Value="{Binding InteractiveMainAngle}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Lateral Angle (α2)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding LateralBranchAngle, StringFormat='{}{0:F1}°'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="90" Value="{Binding LateralBranchAngle}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Divergence Angle (γ)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DivergenceAngle, StringFormat='{}{0:F1}°'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="360" Value="{Binding DivergenceAngle}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Main Ratio (r1)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding InteractiveMainRatio, StringFormat='{}{0:F2}'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0.5" Maximum="0.99" Value="{Binding InteractiveMainRatio}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Lateral Ratio (r2)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding InteractiveLateralRatio, StringFormat='{}{0:F2}'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0.3" Maximum="0.9" Value="{Binding InteractiveLateralRatio}" Margin="0,0,0,8"/>

                                <!-- Physiology & Environment -->
                                <TextBlock Text="Physiology &amp; Environment (Sec 2.3-2.5)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,4"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Leonardo Exponent (Δ)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding InteractivePipeExponent, StringFormat='{}{0:F2}'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="1.5" Maximum="3.0" Value="{Binding InteractivePipeExponent}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Gravitropic Bending" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding InteractiveGravitropism, StringFormat='{}{0:F3}'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0.0" Maximum="0.10" Value="{Binding InteractiveGravitropism}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Canopy Shading Factor" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding InteractiveLightAttenuation, StringFormat='{}{0:F2}'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0.05" Maximum="1.0" Value="{Binding InteractiveLightAttenuation}" Margin="0,0,0,6"/>

                                <DockPanel LastChildFill="False" Margin="0,0,0,1">
                                    <TextBlock Text="Pruning Threshold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding InteractiveShadingThreshold, StringFormat='{}{0:F2}'}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                </DockPanel>
                                <Slider Minimum="0.0" Maximum="0.5" Value="{Binding InteractiveShadingThreshold}" Margin="0,0,0,10"/>

                                <!-- Step and Auto Simulation Controls -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Step (+1)" Height="32" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StepInteractiveTreeCommand}"/>
                                    <Button Grid.Column="2" Content="{Binding AutoGrowthButtonText}" Height="32" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleAutoGrowthCommand}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Reset Tree" Height="26" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Command="{Binding ResetInteractiveTreeCommand}"/>
                                    <Button Grid.Column="2" Content="Reset Camera" Height="26" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Command="{Binding ResetInteractiveCameraCommand}"/>
                                </Grid>

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Tree Ecology Status" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding InteractiveTreeStatistics}" Foreground="{StaticResource PrimaryAccentBrush}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Chapter 2 3D Tree Viewport -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="6">
                        <Border Background="{StaticResource ViewportBackgroundBrush}" CornerRadius="5" ClipToBounds="True"
                                local:OrbitCameraController.IsEnabled="True"
                                local:OrbitCameraController.ResetTrigger="{Binding InteractiveCameraResetTrigger}">
                            <Viewport3D Focusable="True" RenderOptions.EdgeMode="Aliased">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera Position="90,40,90" LookDirection="-90,-10,-90" UpDirection="0,1,0" FieldOfView="45"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup>
                                            <AmbientLight Color="#707070"/>
                                            <DirectionalLight Color="#FFFFFF" Direction="-1,-2,-1"/>
                                            <DirectionalLight Color="#506070" Direction="1,1,1"/>
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                                <ModelVisual3D Content="{Binding InteractiveTreeModel}"/>
                            </Viewport3D>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>